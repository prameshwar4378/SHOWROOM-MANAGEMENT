# ====================================================================
# Tractor Showroom Management System — Production Environment Variables
# ====================================================================
# Copy this file to '.env' on your production server:
#   cp .env.example .env
# Then update the values below with your real server domain and secrets.
# ====================================================================

# 1. Security & Core Django Settings
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# Set to False in production! (True only for local testing)
DJANGO_DEBUG=False

# Comma-separated domain names or IP addresses allowed to access the application
# Example: showroom.yourdomain.com,192.168.1.100,localhost
DJANGO_ALLOWED_HOSTS=showroom.yourdomain.com,127.0.0.1,localhost

# CSRF Trusted Origins (Mandatory for HTTPS POST forms behind Nginx/reverse proxy)
# Example: https://showroom.yourdomain.com,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://showroom.yourdomain.com

# 2. Database Configuration
# Options: 'sqlite3' (default, zero configuration) or 'postgresql' / 'mysql'
DB_ENGINE=sqlite3

# If using PostgreSQL / MySQL, set DATABASE_URL:
# DATABASE_URL=postgres://showroom_user:strong_password@localhost:5432/showroom_db
# Or specify individual variables:
# DB_NAME=showroom_db
# DB_USER=showroom_user
# DB_PASSWORD=strong_password
# DB_HOST=localhost
# DB_PORT=5432

# 3. SSL & HTTPS Security Hardening (Set to True once SSL / Certbot is enabled)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000

# 4. WhatsApp Local Bridge Gateway (Self-Hosted Node.js Server)
LOCAL_WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000

# 5. Gunicorn Application Server Configuration
PORT=8000
WEB_CONCURRENCY=3
